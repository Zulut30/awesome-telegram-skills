{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound recipe evidence registry",
  "type": "object",
  "required": ["schema_version", "library_version", "binding_verified", "quality_or_production_approved", "bindings", "summary", "stable_gate", "recipes", "suite_evidence", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "library_version": {"type": "string", "minLength": 1},
    "binding_verified": {"const": true},
    "quality_or_production_approved": {"const": false},
    "bindings": {
      "type": "object",
      "required": ["distribution_report_sha256", "artifacts", "source_files_sha256", "source_fingerprint", "git_source"],
      "properties": {
        "distribution_report_sha256": {"$ref": "#/$defs/sha256"},
        "source_fingerprint": {"$ref": "#/$defs/sha256"},
        "source_files_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "artifacts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["name", "bytes", "sha256"], "properties": {"name": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
        "git_source": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["commit", "files_verified", "mode"], "properties": {"commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "files_verified": {"type": "integer", "minimum": 1}, "mode": {"const": "read-only-git-object-byte-comparison"}}}]}
      }
    },
    "summary": {"type": "object", "required": ["recipes", "offline_pass", "not_run", "maturity"], "properties": {"recipes": {"type": "integer", "minimum": 1}, "offline_pass": {"type": "integer", "minimum": 0}, "not_run": {"type": "integer", "minimum": 0}, "maturity": {"type": "object"}}},
    "stable_gate": {"type": "object", "required": ["status", "stable_recipes", "missing_recipe_ids", "evidence_complete", "quality_or_production_approved"], "properties": {"status": {"enum": ["no_stable_scope", "missing_evidence", "bound_offline_evidence"]}, "stable_recipes": {"type": "integer", "minimum": 0}, "missing_recipe_ids": {"type": "array", "items": {"type": "string"}}, "evidence_complete": {"type": "boolean"}, "quality_or_production_approved": {"const": false}}},
    "recipes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["recipe_id", "library_version", "maturity", "catalog_verification", "code_sha256", "source_files", "evidence", "limits"], "properties": {
      "recipe_id": {"type": "string", "minLength": 1},
      "library_version": {"type": "string", "minLength": 1},
      "maturity": {"enum": ["reference", "experimental", "stable"]},
      "catalog_verification": {"type": "string"},
      "code_sha256": {"$ref": "#/$defs/sha256"},
      "source_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "evidence": {"type": "object", "required": ["status", "report_pointer", "checks", "kind", "producer_command", "command_provenance"], "properties": {"status": {"enum": ["offline_pass", "not_run"]}, "report_pointer": {"type": ["string", "null"]}, "checks": {"type": "array", "items": {"type": "string", "minLength": 1}}, "kind": {"type": "string"}, "producer_command": {"type": ["array", "null"], "items": {"type": "string"}}, "command_provenance": {"type": "string", "minLength": 1}}},
      "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    }}},
    "suite_evidence": {"type": "object"},
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "$comment": "Structural exchange schema. recipe_evidence.py additionally recomputes the full registry from bound files/results, checks IDs/versions/checks, and refuses changed sources or artifacts. Offline evidence completeness never approves maturity or production."
}
