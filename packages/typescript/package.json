{
  "name": "@awesome-telegram/patterns",
  "version": "0.24.0",
  "description": "Reusable TypeScript components for Telegram Mini Apps",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/frameworks/react.d.ts",
      "default": "./dist/frameworks/react.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue.d.ts",
      "default": "./dist/frameworks/vue.js"
    },
    "./svelte": {
      "types": "./dist/frameworks/svelte.d.ts",
      "default": "./dist/frameworks/svelte.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs && npm run test:types",
    "prepack": "npm run build",
    "test:types": "tsc -p tests/types/tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "7.0.2",
    "vue": "3.5.43"
  }
}
